{
  "expo": {
    "name": "Ghazzarah",
    "slug": "Ghazzarah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash/applogo.png",
    "scheme": "ghazzarah",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/splash/applogo.png"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F5F5F4",
        "foregroundImage": "./assets/splash/applogo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.xain.k19.Ghazzarah",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F4",
          "image": "./assets/splash/transparent.png",
          "dark": {
            "backgroundColor": "#F5F5F4"
          }
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Ghazzarah to use your microphone for voice transaction entry.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa9670b8-174d-4ad6-bd22-69215799a7a2"
      }
    }
  }
}
